FROM ubuntu:24.04

# Defaults to the headless test identity; pass --build-arg USERNAME=paul to
# test the desktop configuration.
ARG USERNAME=paul.lapey

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install required packages
RUN apt-get update && apt-get install -y \
    curl \
    git \
    sudo \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Create test user with sudo privileges
RUN useradd -m -s /bin/bash "$USERNAME" && \
    usermod -aG sudo "$USERNAME" && \
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Copy dotfiles to the user home; home.nix links files from ~/pwl-dotfiles.
COPY . /home/$USERNAME/pwl-dotfiles
RUN chown -R "$USERNAME:$USERNAME" /home/$USERNAME

# Switch to test user
USER $USERNAME
WORKDIR /home/$USERNAME/pwl-dotfiles

# Set HOME environment variable explicitly
ENV HOME=/home/$USERNAME

# Run the bootstrap script
CMD ["./home-manager-bootstrap.sh"]
