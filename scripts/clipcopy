#!/bin/sh
# Copy stdin to the system clipboard, whichever one this machine provides.
# Succeeds silently where there is none, so a remote tmux falls through to
# set-clipboard's OSC 52 push instead of erroring in copy-mode.

if command -v pbcopy >/dev/null 2>&1; then
    exec pbcopy
fi

if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
fi

if [ -n "$DISPLAY" ] && command -v xclip >/dev/null 2>&1; then
    exec xclip -i -selection clipboard
fi

cat >/dev/null
